# -----------------------------------------------------------------------------
# ProxyPulse — Configuration
# -----------------------------------------------------------------------------

# Web Dashboard & REST API published host port
WEB_PORT=8080

# Built-in Rotating Proxy Gateway host port
GATEWAY_PORT=8081
GATEWAY_ENABLED=true

# Gateway proxy routing strategy: "fastest", "random", "round-robin"
GATEWAY_STRATEGY=fastest

# Concurrency for proxy checking (concurrent async workers)
CHECKER_CONCURRENCY=100

# Timeout per proxy check in seconds
CHECKER_TIMEOUT=6.0

# Target URL used to verify proxy reachability and anonymity
CHECK_TARGET_URL=http://httpbin.org/ip

# Automation schedules in seconds (0 = disabled, e.g. 3600 = hourly)
AUTO_SCRAPE_INTERVAL=0
AUTO_CHECK_INTERVAL=0
